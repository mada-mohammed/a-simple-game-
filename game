#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    srand(time(0));

    // اختيار رقم عشوائي من 1 إلى 100
    int secretNumber = rand() % 100 + 1;
    int guess;

    cout << "Guess the number (1-100): ";
    cin >> guess;

    if (guess == secretNumber) {
        cout << "Correct! You guessed the number! ✅" << endl;
    } 
    else {
        cout << "Wrong! ❌" << endl;
        cout << "The correct number was: " << secretNumber << endl;
    }

    return 0;
}
